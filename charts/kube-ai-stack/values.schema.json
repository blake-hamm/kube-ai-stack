{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kube AI Stack Values",
  "description": "Schema for the values.yaml file of the kube-ai-stack Helm chart.",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global configuration settings that apply to all models unless overridden.",
      "properties": {
        "namespace": {
          "type": "string",
          "description": "The Kubernetes namespace to deploy the models into."
        },
        "prometheusUrl": {
          "type": "string",
          "description": "The URL of the Prometheus server for metrics."
        },
        "litellmNamespace": {
          "type": "string",
          "description": "The Kubernetes namespace where LiteLLM is running."
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "pvc": {
          "type": "object",
          "properties": {
            "storageClassName": {
              "type": "string"
            },
            "storage": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            }
          }
        },
        "zeroscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer"
            },
            "cooldownPeriod": {
              "type": "integer"
            },
            "trigger": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "threshold": {
                  "type": "string"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "amd.com/gpu": {
                  "type": "integer"
                },
                "memory": {
                  "type": "string"
                },
                "cpu": {
                  "type": "string"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "amd.com/gpu": {
                  "type": "integer"
                },
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "hfToken": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        },
        "mlflow": {
          "type": "object",
          "description": "MLflow configuration for enabling the subchart",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable MLflow deployment as part of the kube-ai-stack"
            }
          }
        },
        "phoenix": {
          "type": "object",
          "description": "Phoenix configuration for enabling the subchart",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable Phoenix deployment as part of the kube-ai-stack"
            }
          }
        },
        "litellm": {
          "type": "object",
          "properties": {
            "manage_config": {
              "type": "boolean"
            },
            "config": {
              "type": "object",
              "properties": {
                "litellm_settings": {
                  "type": "object"
                },
                "general_settings": {
                  "type": "object"
                },
                "router_settings": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "description": "A list of LLM models to deploy.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the model. This will be used for the deployment, service, and other resources."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether this model is enabled and should be deployed."
          },
          "description": {
            "type": "string",
            "description": "A description of the model."
          },
          "pvc": {
            "type": "object",
            "properties": {
              "storage": {
                "type": "string"
              },
              "storageClassName": {
                "type": "string"
              }
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "template": {
            "type": "string",
            "description": "A Jinja2 template for the model's prompt."
          },
          "image": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            }
          },
          "service": {
            "type": "object",
            "properties": {
              "port": {
                "type": "integer"
              }
            }
          },
          "resources": {
            "type": "object"
          },
          "zeroscaling": {
            "type": "object"
          },
          "litellm": {
            "type": "object",
            "description": "LiteLLM registration settings for this model",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether to register this model in the LiteLLM config"
              }
            }
          }
        },
        "required": [
          "name",
          "enabled"
        ]
      }
    },
    "serverPresets": {
      "type": "object",
      "description": "Server presets for llama-cpp configuration",
      "properties": {
        "llamaCpp": {
          "type": "object",
          "description": "Configuration for llama-cpp server preset",
          "properties": {
            "defaultPort": {
              "type": "integer",
              "description": "Default port for the llama-cpp server",
              "default": 8080
            },
            "healthPath": {
              "type": "string",
              "description": "Health check endpoint path",
              "default": "/health"
            },
            "image": {
              "type": "object",
              "description": "Container image configuration for llama-cpp server",
              "properties": {
                "repository": {
                  "type": "string",
                  "description": "Container image repository"
                },
                "tag": {
                  "type": "string",
                  "description": "Container image tag"
                }
              }
            },
            "envVars": {
              "type": "object",
              "description": "Environment variables for the llama-cpp server",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "description": "Integration configurations for external tools and services",
      "properties": {
        "argocd": {
          "type": "object",
          "description": "ArgoCD integration configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether ArgoCD integration is enabled"
            },
            "syncWave": {
              "type": "object",
              "description": "ArgoCD sync wave configuration for resource deployment order",
              "properties": {
                "pvc": {
                  "type": "string",
                  "description": "Sync wave for PersistentVolumeClaim resources",
                  "default": "20"
                },
                "deployment": {
                  "type": "string",
                  "description": "Sync wave for Deployment resources",
                  "default": "21"
                },
                "service": {
                  "type": "string",
                  "description": "Sync wave for Service resources",
                  "default": "22"
                },
                "serviceMonitor": {
                  "type": "string",
                  "description": "Sync wave for ServiceMonitor resources",
                  "default": "23"
                },
                "autoscaling": {
                  "type": "string",
                  "description": "Sync wave for Autoscaling resources",
                  "default": "24"
                },
                "configMap": {
                  "type": "string",
                  "description": "Sync wave for ConfigMap resources",
                  "default": "20"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "global",
    "models"
  ]
}